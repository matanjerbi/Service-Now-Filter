# ============================================================
#  Ticket Radar – הגדרות
#  העתק את הקובץ הזה ל-.env (באותה תיקייה) ומלא ערכים.
#  כל משתנה אפשר גם להגדיר כמשתנה סביבה רגיל – הוא גובר על .env.
#  קובץ .env לא עולה ל-git (מופיע ב-.gitignore).
# ============================================================

# ---- חובה ----
SN_INSTANCE=https://yourcompany.service-now.com

# ---- הזדהות ----
# basic = משתמש+סיסמה | api_key | oauth | bearer
SN_AUTH_TYPE=basic
SN_USERNAME=
# עדיף לא לשמור כאן סיסמה – להגדיר כמשתנה סביבה לפני ההרצה
SN_PASSWORD=

# כשיהיה API key: SN_AUTH_TYPE=api_key ולמלא:
SN_API_KEY=

# עבור oauth:
SN_CLIENT_ID=
SN_CLIENT_SECRET=

# ---- מה למשוך ----
# טבלאות, מופרדות בפסיק
SN_TABLES=incident,sc_req_item,change_request,problem
# all = כל מה שמותר לראות | my_groups = הקבוצות שלי | groups = רשימה קבועה
SN_SCOPE=all
# עבור SN_SCOPE=groups – שמות צוותים מופרדים בפסיק
SN_SCOPE_GROUPS=
# עבור SN_SCOPE=my_groups עם משתמש שירות – שם המשתמש שלך (שהצוותים שלו ייבחרו)
SN_SCOPE_USER=
# למשוך גם הערות ו-work notes (חיפוש טוב יותר, משיכה איטית יותר)
SN_INCLUDE_JOURNAL=false
# סינון נוסף ב-encoded query, למשל: priority<=3
SN_EXTRA_QUERY=

# ---- רשת ----
# נתיב לקובץ CA ארגוני (PEM) אם ה-ServiceNow חתום בתעודה פנימית
SN_CA_BUNDLE=
SN_VERIFY_SSL=true
SN_TIMEOUT=60
SN_PAGE_SIZE=500
# script (ברירת מחדל) | plain – אם המשיכה מחזירה 0 טיקטים, נסה plain
SN_DATE_QUERY_STYLE=script
# פרוקסי: משתמשים במשתנים הרגילים HTTPS_PROXY / NO_PROXY

# ---- השרת המקומי ----
# 127.0.0.1 = רק מהמחשב הזה. 0.0.0.0 = נגיש מהרשת (בלי סיסמה!)
TR_HOST=127.0.0.1
TR_PORT=8765
TR_DB_PATH=tickets.db
